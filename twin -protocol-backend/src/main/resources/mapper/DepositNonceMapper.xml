<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zmyc.infrastructure.mapper.DepositNonceMapper">

    <select id="findByUserIdAndNonce" resultType="com.zmyc.infrastructure.entity.DepositNonceDO">
        SELECT * FROM deposit_nonce
        WHERE user_id = #{userId} AND nonce = #{nonce}
        LIMIT 1
    </select>

</mapper>
